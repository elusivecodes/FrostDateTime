{
    "name": "@fr0st/datetime",
    "version": "8.1.1",
    "private": false,
    "description": "Immutable date and time handling for JavaScript with locale-aware formatting, parsing, calendar math, and IANA or fixed-offset time zones.",
    "keywords": [
        "date",
        "time",
        "datetime",
        "timezone",
        "locale",
        "localization",
        "icu",
        "parse",
        "format"
    ],
    "homepage": "https://github.com/elusivecodes/FrostDateTime",
    "bugs": {
        "url": "https://github.com/elusivecodes/FrostDateTime/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elusivecodes/FrostDateTime.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-datetime.esm.js",
            "default": "./dist/frost-datetime.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-datetime.esm.js",
    "jsdelivr": "./dist/frost-datetime.min.js",
    "unpkg": "./dist/frost-datetime.min.js",
    "module": "./dist/frost-datetime.esm.js",
    "files": [
        "dist",
        "Formats.md",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build",
        "lint": "eslint",
        "locales": "php generate-locales.php > src/formatter/locales.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
